<!DOCTYPE html>
<html lang="{{ app.request.locale == 'sk' ? 'sk' : 'cs' }}" data-store="{{ store.code }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ store.name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Trička a dresy s potiskem na míru.{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ app.request.uri }}{% endblock %}">
    {% if store.partnerCode %}
        <link rel="alternate" hreflang="{{ store.locale }}" href="{{ app.request.uri }}">
    {% endif %}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ctext y='14' font-size='14'%3E%F0%9F%91%95%3C/text%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    {{ importmap('app') }}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'OnlineStore',
        '@id': 'https://' ~ store.host ~ '/#organization',
        'name': store.name,
        'url': 'https://' ~ store.host ~ '/',
        'email': store.email,
        'telephone': store.phone,
        'address': {'@type': 'PostalAddress', 'streetAddress': legal.address, 'addressCountry': (store.currency == 'EUR' ? 'SK' : 'CZ')},
        'founder': {'@type': 'Person', 'name': legal.name},
        'taxID': legal.ico
    }|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
</head>
<body>
    <a href="#obsah" class="skip">{{ 'skip_to_content'|trans }}</a>
    {% include '_partials/header.html.twig' %}
    {% for msg in app.flashes('cart') %}
        <div class="wrap"><div class="cart-toast" role="status">
            <span>✓ {{ 'cart.added'|trans }}</span>
            <a href="{{ path('cart') }}" class="btn btn-sm btn-primary">{{ 'cart.view'|trans }}</a>
        </div></div>
    {% endfor %}
    <main id="obsah" tabindex="-1">{% block body %}{% endblock %}</main>
    {% include '_partials/footer.html.twig' %}
</body>
</html>
