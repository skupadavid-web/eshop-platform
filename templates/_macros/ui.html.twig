{% macro stars(r) %}<span class="stars" aria-hidden="true">{% for i in 1..5 %}{{ i <= r|round ? '★' : '☆' }}{% endfor %}</span>{% endmacro %}

{% macro product_card(p) %}
    {% set c0 = p.primaryColor %}
    <a class="pcard" href="{{ p.path }}">
        <div class="shirt-tile">
            {%- if p.image -%}
                <img src="{{ store.imageUrl(p.image) }}" alt="{{ p.name }}{{ c0 ? ', ' ~ c0.name : '' }}" loading="lazy" decoding="async" width="300" height="360">
            {%- else -%}
                {{ shirt(c0 ? c0.hex : '#0b5fa5', p.motif, p.name ~ (c0 ? ', ' ~ c0.name : '')) }}
            {%- endif -%}
        </div>
        <div><div class="ptitle">{{ p.name }}</div>{% if p.subtitle %}<div class="psub">{{ p.subtitle }}</div>{% endif %}</div>
        <div class="pfoot">
            <span class="pprice">{{ p.price|money }}</span>
            {% if p.colors|length > 1 %}
            <span class="pdots" aria-hidden="true">
                {% for col in p.colors|slice(0, 5) %}<i style="background:{{ col.hex }}"></i>{% endfor %}
                {% if p.colors|length > 5 %}<i style="background:var(--surface-3)"></i>{% endif %}
            </span>
            {% endif %}
        </div>
        {% if p.rating %}
        <div class="rating">{{ _self.stars(p.rating) }} <span>{{ p.rating|number_format(1, ',') }} ({{ p.reviews }} {{ 'reviews'|trans }})</span></div>
        {% endif %}
    </a>
{% endmacro %}

{% macro swatch_row(product) %}
    <div class="swatchrow" role="group" aria-label="{{ 'product.color'|trans }}">
        {% for col in product.colors %}
            <a class="swatch" href="{{ col.path }}" aria-pressed="{{ col.variantId == product.variantId ? 'true' : 'false' }}" aria-label="{{ col.name }}" style="background:{{ col.hex }}"></a>
        {% endfor %}
    </div>
{% endmacro %}

{% macro size_row(product) %}
    <div class="sizerow" role="radiogroup" aria-label="{{ 'product.size'|trans }}">
        {% for s in product.sizes %}
            <label class="sizechip{{ s.available ? '' : ' is-out' }}">
                <input type="radio" name="variant_size_id" value="{{ s.variantSizeId }}"{{ loop.first ? ' checked' : '' }}{{ s.available ? ' required' : ' disabled' }} class="visually-hidden">
                <span>{{ s.label }}</span>
            </label>
        {% endfor %}
    </div>
{% endmacro %}

{% macro qty_input() %}
    <div class="qty">
        <button type="button" class="qminus" aria-label="{{ 'qty.less'|trans }}">−</button>
        <input type="number" name="qty" value="1" min="1" max="99" class="num" aria-label="{{ 'qty.label'|trans }}">
        <button type="button" class="qplus" aria-label="{{ 'qty.more'|trans }}">+</button>
    </div>
{% endmacro %}

{% macro qty() %}
    <div class="qty">
        <button type="button" aria-label="{{ 'qty.less'|trans }}">−</button>
        <input value="1" class="num" aria-label="{{ 'qty.label'|trans }}">
        <button type="button" aria-label="{{ 'qty.more'|trans }}">+</button>
    </div>
{% endmacro %}

{% macro checkout_field(name, label, data, errors, type='text', full=false) %}
    <label class="field{{ full ? ' full' : '' }}">
        <span>{{ label }}</span>
        <input type="{{ type }}" name="{{ name }}" value="{{ attribute(data, name) }}"
               {%- if type == 'email' %} autocomplete="email" inputmode="email"{% endif %}
               {%- if name in ['firstName','lastName'] %} autocomplete="{{ name == 'firstName' ? 'given-name' : 'family-name' }}"{% endif %}>
        {% if errors[name] is defined %}<span class="err">{{ errors[name]|trans }}</span>{% endif %}
    </label>
{% endmacro %}

{% macro crumb(items) %}
    <nav class="crumb" aria-label="{{ 'breadcrumb'|trans }}">
        {% for it in items %}
            {% if it.href is defined and not loop.last %}
                <a href="{{ it.href }}">{{ it.label }}</a><span aria-hidden="true">/</span>
            {% else %}
                <span aria-current="page">{{ it.label }}</span>
            {% endif %}
        {% endfor %}
    </nav>
{% endmacro %}
