{% macro stars(r) %}<span class="stars" aria-hidden="true">{% for i in 1..5 %}{{ i <= r|round ? '★' : '☆' }}{% endfor %}</span>{% endmacro %}

{% macro product_card(p, view, loc) %}
    {% set c0 = view.colors[p.colorKeys[0]] %}
    <a class="pcard" href="{{ path('product', {slug: p.slug}) }}">
        <div class="shirt-tile">{{ shirt(c0.hex, p.motif, p.name(loc) ~ ', ' ~ c0.name(loc)) }}</div>
        <div><div class="ptitle">{{ p.name(loc) }}</div><div class="psub">{{ p.subtitle(loc) }}</div></div>
        <div class="pfoot">
            <span class="pprice">{{ p.priceFor(loc)|money }}</span>
            <span class="pdots" aria-hidden="true">
                {% for k in p.colorKeys|slice(0, 5) %}<i style="background:{{ view.colors[k].hex }}"></i>{% endfor %}
                {% if p.colorKeys|length > 5 %}<i style="background:var(--surface-3)"></i>{% endif %}
            </span>
        </div>
        <div class="rating">{{ _self.stars(p.rating) }} <span>{{ p.rating|number_format(1, ',') }} ({{ p.reviews }} {{ 'reviews'|trans }})</span></div>
    </a>
{% endmacro %}

{% macro swatch_row(p, view, loc, selected) %}
    <div class="swatchrow" role="group" aria-label="{{ 'product.color'|trans }}">
        {% for k in p.colorKeys %}
            {% set col = view.colors[k] %}
            <button type="button" class="swatch" aria-pressed="{{ k == selected ? 'true' : 'false' }}" aria-label="{{ col.name(loc) }}" style="background:{{ col.hex }}"></button>
        {% endfor %}
    </div>
{% endmacro %}

{% macro size_row(p, loc) %}
    <div class="sizerow" role="group" aria-label="{{ 'product.size'|trans }}">
        {% for s in p.sizes %}
            {% set out = s in p.soldOutSizes %}
            <button type="button" class="sizechip" aria-pressed="{{ loop.index == 3 and not out ? 'true' : 'false' }}"{{ out ? ' disabled aria-label="' ~ s ~ ' – ' ~ ('product.sold_out'|trans) ~ '"' : '' }}>{{ s }}</button>
        {% endfor %}
    </div>
{% endmacro %}

{% macro qty() %}
    <div class="qty">
        <button type="button" aria-label="{{ 'qty.less'|trans }}">−</button>
        <input value="1" class="num" aria-label="{{ 'qty.label'|trans }}">
        <button type="button" aria-label="{{ 'qty.more'|trans }}">+</button>
    </div>
{% endmacro %}

{% macro crumb(items) %}
    <nav class="crumb" aria-label="{{ 'breadcrumb'|trans }}">
        {% for it in items %}
            {% if it.href is defined and not loop.last %}
                <a href="{{ it.href }}">{{ it.label }}</a><span aria-hidden="true">/</span>
            {% else %}
                <span aria-current="page">{{ it.label }}</span>
            {% endif %}
        {% endfor %}
    </nav>
{% endmacro %}
