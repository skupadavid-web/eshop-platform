{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}{{ 'home.title'|trans }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ 'home.meta'|trans }}{% endblock %}

{% block body %}
<div class="wrap">
    <section class="hero">
        <div class="stack" style="gap:18px">
            <span class="eyebrow">{{ 'home.eyebrow'|trans }}</span>
            <h1>{{ 'home.headline'|trans }}</h1>
            <p class="lede">{{ 'home.lede'|trans }}</p>
            {% if view.menu is not empty %}
            <div class="cluster">
                <a class="btn btn-primary" href="{{ view.menu[0].path }}">{{ 'home.cta_browse'|trans }}</a>
            </div>
            {% endif %}
        </div>
        <div class="fan" aria-hidden="true">
            <div class="shirt-tile s1">{{ shirt('#3a8f4f', 'blank') }}</div>
            <div class="shirt-tile s2">{{ shirt('#1d1c1a', 'blank') }}</div>
            <div class="shirt-tile s3">{{ shirt('#c0392b', 'blank') }}</div>
        </div>
    </section>

    {% if bestsellers is not empty %}
    <section class="section-tight">
        <div class="cat-head"><h2>{{ 'home.bestsellers'|trans }}</h2>
            {% if view.menu is not empty %}<a class="link" href="{{ view.menu[0].path }}">{{ 'all'|trans }} →</a>{% endif %}</div>
        <div class="pgrid">{% for p in bestsellers %}{{ ui.product_card(p) }}{% endfor %}</div>
    </section>
    {% endif %}

    {% if view.menu is not empty %}
    <section class="section-tight">
        <h2 style="margin-bottom:18px">{{ 'home.categories'|trans }}</h2>
        <div class="cat-tiles">
            {% for c in view.menu %}
                <a class="cat-tile" href="{{ c.path }}">
                    <div class="mini">{{ shirt('#2456c9', 'blank') }}</div>
                    <span>{{ c.name }}</span>
                </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <section class="section-tight">
        <h2 style="margin-bottom:18px">{{ 'home.how_it_works'|trans }}</h2>
        <div class="stepgrid">
            <div class="step"><span class="n">01</span><b>{{ 'home.step1_t'|trans }}</b><p style="color:var(--ink-muted);font-size:14px">{{ 'home.step1_d'|trans }}</p></div>
            <div class="step"><span class="n">02</span><b>{{ 'home.step2_t'|trans }}</b><p style="color:var(--ink-muted);font-size:14px">{{ 'home.step2_d'|trans }}</p></div>
            <div class="step"><span class="n">03</span><b>{{ 'home.step3_t'|trans }}</b><p style="color:var(--ink-muted);font-size:14px">{{ 'home.step3_d'|trans }}</p></div>
        </div>
    </section>

    <section class="section-tight"><div class="seoblock">
        <h2>{{ 'home.seo_h'|trans({'%store%': store.name}) }}</h2>
        <p>{{ 'home.seo_p1'|trans }}</p>
        <p>{{ 'home.seo_p2'|trans }}</p>
        <p>{{ 'home.seo_p3'|trans }}</p>
    </div></section>
</div>
{% endblock %}
