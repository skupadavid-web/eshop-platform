{% extends 'base.html.twig' %}
{% block title %}{{ 'cart.title'|trans }} — {{ store.name }}{% endblock %}
{% block body %}
<div class="wrap section-tight">
    <h1 style="margin-bottom:20px">{{ 'cart.title'|trans }}</h1>
    <p style="color:var(--ink-muted);padding:24px 0">{{ 'cart.empty'|trans }}</p>
    <a href="{{ path('home') }}" class="btn btn-primary">{{ 'cart.continue_shopping'|trans }}</a>
</div>
{% endblock %}
