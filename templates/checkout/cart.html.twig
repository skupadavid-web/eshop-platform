{% extends 'base.html.twig' %}
{% set loc = app.request.locale %}
{% block title %}{{ 'cart.title'|trans }} — {{ store.name }}{% endblock %}
{% block body %}
<div class="wrap section-tight">
    <h1 style="margin-bottom:20px">{{ 'cart.title'|trans }}</h1>
    {% set subtotal = 0 %}
    {% for it in items %}{% set subtotal = subtotal + it.product.priceFor(loc) * it.qty %}{% endfor %}
    {% set ship = store.currency == 'EUR' ? 2.5 : 59 %}
    <div class="cart-layout">
        <div>
            <div class="freebar">{{ 'cart.free_ship_hint'|trans }}<div class="track"><i></i></div></div>
            {% for it in items %}
                {% set col = view.colors[it.color] %}
                <div class="cart-item">
                    <div class="shirt-tile">{{ shirt(col.hex, it.product.motif) }}</div>
                    <div>
                        <div style="font-weight:600">{{ it.product.name(loc) }}</div>
                        <div class="ci-meta">{{ 'product.color'|trans }}: {{ col.name(loc) }} · {{ 'product.size'|trans }}: {{ it.size }}</div>
                        <div class="qty" style="margin-top:10px">
                            <button type="button" aria-label="{{ 'qty.less'|trans }}">−</button>
                            <input value="{{ it.qty }}" class="num" aria-label="{{ 'qty.label'|trans }}">
                            <button type="button" aria-label="{{ 'qty.more'|trans }}">+</button>
                        </div>
                        <button class="link" style="font-size:13px;margin-top:8px;display:inline-block">{{ 'cart.remove'|trans }}</button>
                    </div>
                    <div class="ci-price">{{ (it.product.priceFor(loc) * it.qty)|money }}</div>
                </div>
            {% endfor %}
        </div>
        <aside class="summary">
            <h3 style="margin-bottom:8px">{{ 'cart.summary'|trans }}</h3>
            <div class="codeinput">
                <input aria-label="{{ 'cart.coupon'|trans }}" placeholder="{{ 'cart.coupon'|trans }}">
                <button class="btn btn-ghost btn-sm">{{ 'apply'|trans }}</button>
            </div>
            <div class="row"><span>{{ 'cart.subtotal'|trans }}</span><span class="num">{{ subtotal|money }}</span></div>
            <div class="row"><span>{{ 'cart.shipping_from'|trans }}</span><span class="num">{{ ship|money }}</span></div>
            <div class="row total"><span>{{ 'cart.total'|trans }}</span><span class="num">{{ (subtotal + ship)|money }}</span></div>
            <a href="{{ path('checkout') }}" class="btn btn-primary btn-lg" style="margin-top:16px">{{ 'cart.to_checkout'|trans }}</a>
        </aside>
    </div>
</div>
{% endblock %}
