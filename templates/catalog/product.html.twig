{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}
{% set c0 = product.selectedColor %}
{% block title %}{{ product.name }}{{ c0 ? ' – ' ~ c0.name : '' }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ product.metaDescription ?: (product.descriptionHtml ? product.descriptionHtml|striptags|slice(0, 155) : product.name) }}{% endblock %}
{% block canonical %}{{ app.request.schemeAndHttpHost }}{{ product.canonicalPath }}{% endblock %}
{% block body %}
{% for block in json_ld %}<script type="application/ld+json">{{ block|raw }}</script>
{% endfor %}
<div class="wrap">
    {{ ui.crumb(
        [{label: 'nav.home'|trans, href: path('home')}]
        |merge(product.breadcrumbs|map(c => {label: c.name, href: c.path}))
        |merge([{label: product.name}])
    ) }}

    <div class="pd">
        <div class="pd-gallery">
            <div class="pd-main" id="pdMain">
                {%- if c0.image -%}
                    <img src="{{ store.imageUrl(c0.image) }}" alt="{{ product.name }}, {{ c0.name }}" decoding="async" width="640" height="768">
                {%- else -%}
                    {{ shirt(c0.hex, product.motif, product.name ~ ', ' ~ c0.name) }}
                {%- endif -%}
            </div>
            {% if product.colors|length > 1 %}
            <div class="pd-thumbs" role="group" aria-label="{{ 'product.color'|trans }}">
                {% for col in product.colors %}
                    <a class="pd-thumb" href="{{ col.path }}" aria-pressed="{{ col.variantId == product.variantId ? 'true' : 'false' }}" aria-label="{{ 'product.color'|trans }} {{ col.name }}">
                        {%- if col.image -%}<img src="{{ store.imageUrl(col.image) }}" alt="" loading="lazy" decoding="async" width="72" height="86">{%- else -%}{{ shirt(col.hex, product.motif) }}{%- endif -%}
                    </a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        <div class="pd-buy">
            <h1>{{ product.name }}</h1>
            {% if product.subtitle %}<div class="sub">{{ product.subtitle }}</div>{% endif %}
            <div class="price-line">
                <span class="price-big">{{ product.price|money }}</span>
                {% if product.priceBeforeDiscount and product.priceBeforeDiscount > product.price %}
                    <span class="price-note"><s>{{ product.priceBeforeDiscount|money }}</s></span>
                {% endif %}
                <span class="price-note">{{ 'product.price_note'|trans }}</span>
            </div>

            {% if product.colors|length > 1 %}
            <div class="buy-field">
                <div class="flabel"><span id="pdColorLbl">{{ 'product.color'|trans }}</span><span class="val" id="pdColorName">{{ c0.name }}</span></div>
                {{ ui.swatch_row(product) }}
            </div>
            {% endif %}
            <form method="post" action="{{ path('cart_add') }}" class="buy-form">
                <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                <input type="hidden" name="redirect_to" value="{{ product.path }}">
                {% if product.sizes is not empty %}
                <div class="buy-field">
                    <div class="flabel"><span id="pdSizeLbl">{{ 'product.size'|trans }}</span></div>
                    {{ ui.size_row(product) }}
                </div>
                {% else %}
                    <input type="hidden" name="variant_size_id" value="0">
                {% endif %}
                <div class="buy-field">
                    <div class="flabel"><span>{{ 'qty.label'|trans }}</span></div>
                    {{ ui.qty_input() }}
                </div>
                <div class="buy-actions">
                    <button type="submit" class="btn btn-primary btn-lg">{{ 'product.add_to_cart'|trans }} · {{ product.price|money }}</button>
                </div>
            </form>
            <div class="delivery-mini">
                <div><span>{{ 'ship.packeta_point'|trans }}</span><b>{{ (store.currency == 'EUR' ? 2.5 : 59)|money }}</b></div>
                <div><span>{{ 'ship.post'|trans }}</span><b>{{ (store.currency == 'EUR' ? 3.9 : 89)|money }}</b></div>
                <div><span>{{ 'ship.pickup'|trans }}</span><b>{{ 'free'|trans }}</b></div>
            </div>
            <div class="trust-row">
                <span>✓ {{ 'trust.print'|trans }}</span>
                <span>✓ {{ 'trust.returns'|trans }}</span>
            </div>
        </div>
    </div>

    <div class="pd-below">
        {% set body = product.descriptionExtendedHtml ?: product.descriptionHtml %}
        {% if body %}
        <div><h2 style="margin-bottom:10px">{{ 'product.description'|trans }}</h2>
            <div class="page-body" style="color:var(--ink-muted)">{{ body|raw }}</div>
        </div>
        {% endif %}

        {% if product.parameters is not empty %}
        <div><h2 style="margin-bottom:10px">{{ 'product.parameters'|trans }}</h2>
            <table class="spec-table">
                {% for row in product.parameters %}
                    <tr><td>{{ row.name }}</td><td>{{ row.value }}</td></tr>
                {% endfor %}
            </table>
        </div>
        {% endif %}

        {% if product.faqs is not empty %}
        <div><h2 style="margin-bottom:12px">{{ 'product.faq'|trans }}</h2>
            <div class="acc">
                {% for f in product.faqs %}
                    <details>
                        <summary>{{ f.question }}<span aria-hidden="true">+</span></summary>
                        <div class="acc-body">{{ f.answerHtml|raw }}</div>
                    </details>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
