{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}
{% set loc = app.request.locale %}
{% set c0 = view.colors[product.colorKeys[0]] %}
{% block title %}{{ product.name(loc) }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ product.description(loc)|striptags|slice(0, 155) }}{% endblock %}
{% block body %}
<div class="wrap">
    {{ ui.crumb([
        {label: 'nav.home'|trans, href: path('home')},
        {label: category ? category.name(loc) : 'Trička', href: path('category', {slug: product.categorySlug})},
        {label: product.name(loc)}
    ]) }}

    <div class="pd">
        <div class="pd-gallery">
            <div class="pd-main" id="pdMain">{{ shirt(c0.hex, product.motif, product.name(loc) ~ ', ' ~ c0.name(loc)) }}</div>
            <div class="pd-thumbs" role="group" aria-label="{{ 'product.color'|trans }}">
                {% for k in product.colorKeys %}
                    <button type="button" class="pd-thumb" aria-pressed="{{ loop.first ? 'true' : 'false' }}" aria-label="{{ 'product.color'|trans }} {{ view.colors[k].name(loc) }}">{{ shirt(view.colors[k].hex, product.motif) }}</button>
                {% endfor %}
            </div>
        </div>
        <div class="pd-buy">
            <h1>{{ product.name(loc) }}</h1>
            <div class="sub">{{ product.subtitle(loc) }}</div>
            <div class="rating" style="margin-top:8px">{{ ui.stars(product.rating) }} <span>{{ product.rating|number_format(1, ',') }} {{ 'product.of_5'|trans }} · {{ product.reviews }} {{ 'reviews'|trans }}</span></div>
            <div class="price-line"><span class="price-big">{{ product.priceFor(loc)|money }}</span><span class="price-note">{{ 'product.price_note'|trans }}</span></div>

            <div class="buy-field">
                <div class="flabel"><span id="pdColorLbl">{{ 'product.color'|trans }}</span><span class="val" id="pdColorName">{{ c0.name(loc) }}</span></div>
                {{ ui.swatch_row(product, view, loc, product.colorKeys[0]) }}
            </div>
            <div class="buy-field">
                <div class="flabel"><span id="pdSizeLbl">{{ 'product.size'|trans }}</span><a class="link" href="{{ path('page', {slug: 'jak-nakupovat'}) }}" style="font-weight:500;font-size:13px">{{ 'product.size_chart'|trans }}</a></div>
                {{ ui.size_row(product, loc) }}
            </div>
            <div class="buy-field">
                <div class="flabel"><span>{{ 'qty.label'|trans }}</span></div>
                {{ ui.qty() }}
            </div>
            <div class="buy-actions">
                <button class="btn btn-primary btn-lg">{{ 'product.add_to_cart'|trans }} · {{ product.priceFor(loc)|money }}</button>
            </div>
            <div class="stock-ok"><span class="dot" style="width:8px;height:8px;background:currentColor;border-radius:50%"></span> {{ 'product.in_stock'|trans }}</div>
            <div class="delivery-mini">
                <div><span>{{ 'ship.packeta_point'|trans }}</span><b>{{ (store.currency == 'EUR' ? 2.5 : 59)|money }}</b></div>
                <div><span>{{ 'ship.post'|trans }}</span><b>{{ (store.currency == 'EUR' ? 3.9 : 89)|money }}</b></div>
                <div><span>{{ 'ship.pickup'|trans }}</span><b>{{ 'free'|trans }}</b></div>
            </div>
            <div class="trust-row">
                <span>✓ {{ 'trust.print'|trans }}</span>
                <span>✓ {{ 'trust.returns'|trans }}</span>
                <span>✓ {{ 'trust.verified'|trans }}</span>
            </div>
        </div>
    </div>

    <div class="pd-below">
        <div><h2 style="margin-bottom:10px">{{ 'product.description'|trans }}</h2><p style="color:var(--ink-muted)">{{ product.description(loc) }}</p></div>
        <div><h2 style="margin-bottom:10px">{{ 'product.parameters'|trans }}</h2>
            <table class="spec-table">
                <tr><td>{{ 'param.material'|trans }}</td><td>{{ product.material }}</td></tr>
                <tr><td>{{ 'param.weight'|trans }}</td><td>{{ product.gramaz }} g/m²</td></tr>
                <tr><td>{{ 'param.fit'|trans }}</td><td>{{ product.gender }}</td></tr>
                <tr><td>{{ 'param.print'|trans }}</td><td>{{ 'param.print_val'|trans }}</td></tr>
                <tr><td>{{ 'param.care'|trans }}</td><td>{{ 'param.care_val'|trans }}</td></tr>
            </table>
        </div>
        <div><h2 style="margin-bottom:12px">{{ 'product.same_motif'|trans }}</h2>
            <div class="variant-links">
                {% for g in ['Pánské','Dámské','Dětské'] %}
                    <a class="pcard" href="{{ path('product', {slug: product.slug}) }}">
                        <div class="shirt-tile">{{ shirt(c0.hex, product.motif, g ~ ' ' ~ product.name(loc)) }}</div>
                        <div class="ptitle">{{ g }} — {{ product.name(loc) }}</div>
                        <span class="pprice">{{ product.priceFor(loc)|money }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
        <div><h2 style="margin-bottom:12px">{{ 'product.faq'|trans }}</h2>
            <div class="acc">
                {% for i in 1..3 %}
                    <details><summary>{{ ('product.faq' ~ i ~ '_q')|trans }}<span aria-hidden="true">+</span></summary>
                        <div class="acc-body">{{ ('product.faq' ~ i ~ '_a')|trans }}</div></details>
                {% endfor %}
            </div>
        </div>
        <div><h2 style="margin-bottom:12px">{{ 'product.also_offer'|trans }}</h2>
            <div class="pgrid" style="grid-template-columns:repeat(3,1fr)">{% for p in related %}{{ ui.product_card(p, view, loc) }}{% endfor %}</div>
        </div>
    </div>
</div>
{% endblock %}
