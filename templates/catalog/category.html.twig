{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}
{% set loc = app.request.locale %}
{% block title %}{{ category.name(loc) }} — {{ store.name }}{% endblock %}
{% block body %}
<div class="wrap">
    {{ ui.crumb(
        [{label: 'nav.home'|trans, href: path('home')}]
        |merge(parent ? [{label: parent.name(loc), href: path('category', {slug: parent.slug})}] : [])
        |merge([{label: category.name(loc)}])
    ) }}

    <div class="cat-head">
        <div>
            <h1>{{ category.name(loc) }}</h1>
            <p style="color:var(--ink-muted);font-size:14px;margin-top:4px">{{ category.count }} {{ 'products'|trans }} · {{ 'category.in_stock'|trans }}</p>
        </div>
        <label class="cluster" style="gap:8px;font-size:14px">{{ 'sort.label'|trans }}
            <select class="sortsel">
                <option>{{ 'sort.bestsellers'|trans }}</option>
                <option>{{ 'sort.newest'|trans }}</option>
                <option>{{ 'sort.price_asc'|trans }}</option>
                <option>{{ 'sort.price_desc'|trans }}</option>
            </select>
        </label>
    </div>

    <div class="cat-layout">
        <aside class="filters" aria-label="{{ 'filters'|trans }}">
            <div class="fgroup"><h4>{{ 'filter.gender'|trans }}</h4>
                {% for g in ['Pánské','Dámské','Dětské','Unisex'] %}
                    <label class="chk"><input type="checkbox"{{ loop.index == 2 ? ' checked' : '' }}> {{ g }}</label>
                {% endfor %}
            </div>
            <div class="fgroup"><h4 id="fBarva">{{ 'filter.color'|trans }}</h4>
                <div class="swatchrow" role="group" aria-labelledby="fBarva">
                    {% for k, col in view.colors|slice(0, 10) %}
                        <button type="button" class="swatch" aria-pressed="false" aria-label="{{ col.name(loc) }}" style="background:{{ col.hex }}"></button>
                    {% endfor %}
                </div>
            </div>
            <div class="fgroup"><h4 id="fVel">{{ 'filter.size'|trans }}</h4>
                <div class="sizerow" role="group" aria-labelledby="fVel">
                    {% for s in ['XS','S','M','L','XL','XXL','XXXL'] %}
                        <button type="button" class="sizechip" aria-pressed="{{ loop.index == 3 ? 'true' : 'false' }}">{{ s }}</button>
                    {% endfor %}
                </div>
            </div>
            <div class="fgroup"><h4>{{ 'filter.price'|trans }}</h4>
                <input type="range" min="0" max="100" value="60" aria-label="{{ 'filter.max_price'|trans }}" style="width:100%;accent-color:var(--accent)">
                <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--ink-muted)"><span>0</span><span>{{ 700|money }}</span></div>
            </div>
        </aside>

        <div>
            <div class="catgrid">{% for p in products %}{{ ui.product_card(p, view, loc) }}{% endfor %}</div>
            <nav class="pager" aria-label="{{ 'pagination'|trans }}">
                <span aria-hidden="true" style="opacity:.4">‹</span>
                <a class="on" aria-current="page" href="{{ path('category', {slug: category.slug}) }}">1</a>
                <a href="{{ path('category', {slug: category.slug}) }}" aria-label="{{ 'page_n'|trans({'%n%': 2}) }}">2</a>
                <a href="{{ path('category', {slug: category.slug}) }}" aria-label="{{ 'page_n'|trans({'%n%': 3}) }}">3</a>
                <a href="{{ path('category', {slug: category.slug}) }}" aria-label="{{ 'page_next'|trans }}">›</a>
            </nav>
            <div class="urlhint">{{ 'category.url_hint'|trans }}: {{ store.host }}/{{ category.slug }}/stranka-2</div>
        </div>
    </div>
</div>
{% endblock %}
