{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}
{% set active_category_id = cat.categoryId %}
{% block title %}{{ cat.name }}{{ cat.page > 1 ? ' – ' ~ ('page_n'|trans({'%n%': cat.page})) : '' }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ cat.metaDescription ?: (cat.bodyHtml ? cat.bodyHtml|striptags|slice(0, 155) : cat.name) }}{% endblock %}
{% block canonical %}{{ app.request.schemeAndHttpHost }}{{ cat.pagePath(cat.page) }}{% endblock %}
{% block body %}
<div class="wrap">
    {{ ui.crumb(
        [{label: 'nav.home'|trans, href: path('home')}]
        |merge(cat.crumbs|map(c => {label: c.name, href: c.path}))
        |merge([{label: cat.name}])
    ) }}

    <div class="cat-head">
        <div>
            <h1>{{ cat.name }}</h1>
            {% if cat.total %}<p style="color:var(--ink-muted);font-size:14px;margin-top:4px">{{ cat.total }} {{ 'products'|trans }}</p>{% endif %}
        </div>
    </div>

    {% if cat.subcategories is not empty %}
    <nav class="subcats" aria-label="{{ 'nav.categories'|trans }}" style="display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 18px">
        {% for s in cat.subcategories %}<a class="sizechip" href="{{ s.path }}">{{ s.name }}</a>{% endfor %}
    </nav>
    {% endif %}

    {% if cat.products is empty %}
        <p style="color:var(--ink-muted);padding:32px 0">{{ 'category.empty'|trans }}</p>
    {% else %}
        <div class="catgrid">{% for p in cat.products %}{{ ui.product_card(p) }}{% endfor %}</div>
    {% endif %}

    {% if cat.pages > 1 %}
    <nav class="pager" aria-label="{{ 'pagination'|trans }}">
        {% if cat.hasPrev %}<a href="{{ cat.pagePath(cat.page - 1) }}" aria-label="{{ 'page_prev'|trans }}">‹</a>{% else %}<span aria-hidden="true" style="opacity:.4">‹</span>{% endif %}
        {% for n in 1..cat.pages %}
            {% if n == cat.page %}
                <a class="on" aria-current="page" href="{{ cat.pagePath(n) }}">{{ n }}</a>
            {% elseif n <= 2 or n > cat.pages - 2 or (n >= cat.page - 1 and n <= cat.page + 1) %}
                <a href="{{ cat.pagePath(n) }}" aria-label="{{ 'page_n'|trans({'%n%': n}) }}">{{ n }}</a>
            {% elseif n == 3 or n == cat.pages - 2 %}
                <span aria-hidden="true">…</span>
            {% endif %}
        {% endfor %}
        {% if cat.hasNext %}<a href="{{ cat.pagePath(cat.page + 1) }}" aria-label="{{ 'page_next'|trans }}">›</a>{% else %}<span aria-hidden="true" style="opacity:.4">›</span>{% endif %}
    </nav>
    {% endif %}

    {% if cat.bodyHtml and cat.page == 1 %}
    <div class="seoblock" style="margin-top:32px">{{ cat.bodyHtml|raw }}</div>
    {% endif %}
</div>
{% endblock %}
