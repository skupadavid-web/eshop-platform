{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}
{% block title %}{{ page.title }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ page.metaDescription ?: (page.bodyHtml ? page.bodyHtml|striptags|slice(0, 155) : page.title) }}{% endblock %}
{% block canonical %}{{ app.request.schemeAndHttpHost }}{{ page.path }}{% endblock %}
{% block body %}
<div class="wrap section"><div class="content-page">
    {{ ui.crumb([{label: 'nav.home'|trans, href: path('home')}, {label: page.title}]) }}
    <h1>{{ page.title }}</h1>
    {% if page.bodyHtml %}<div class="page-body">{{ page.bodyHtml|raw }}</div>{% endif %}
</div></div>
{% endblock %}
