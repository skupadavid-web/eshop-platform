{% import '_macros/ui.html.twig' as ui %}
<div class="promo"><div class="wrap">
    <span>{{ 'promo.print'|trans }}</span>
    <span><b>{{ 'promo.shipping'|trans }}</b></span>
    <span>{{ 'promo.returns'|trans }}</span>
</div></div>

<header class="shead"><div class="wrap shead-in">
    <a href="{{ path('home') }}" class="logo">
        <span class="mark" aria-hidden="true">{{ shirt('#0b5fa5', 'blank') }}</span>{{ store.name }}
    </a>
    <form class="search" role="search" action="{{ path('search') }}">
        <span aria-hidden="true">⌕</span>
        <input type="search" name="q" aria-label="{{ 'search.label'|trans }}" placeholder="{{ 'search.placeholder'|trans }}">
    </form>
    <div class="hicons">
        <a href="{{ path('cart') }}" class="iconbtn" aria-label="{{ 'cart.aria'|trans({'%n%': 0}) }}">
            <span aria-hidden="true">🛒</span> {{ 'cart.title'|trans }}
        </a>
    </div>
</div>

{% if view.menu is not empty %}
<nav class="subnav" aria-label="{{ 'nav.categories'|trans }}"><ul class="wrap">
    {% for c in view.menu %}
        {% set active = active_category_id is defined and active_category_id == c.categoryId %}
        {% if c.children is empty %}
            <li><a href="{{ c.path }}"{{ active ? ' aria-current="page"' : '' }}>{{ c.name }}</a></li>
        {% else %}
            <li class="navp"{{ c.mega ? ' data-mega="1"' : '' }}>
                <a href="{{ c.path }}" aria-haspopup="true" aria-expanded="false"{{ active ? ' aria-current="page"' : '' }}>{{ c.name }} <span class="caret" aria-hidden="true">▾</span></a>
                <div class="submenu"><div class="submenu-in">
                    <a class="sm-all" href="{{ c.path }}">{{ 'nav.all_in'|trans({'%cat%': c.name}) }} →</a>
                    {% for k in c.children %}
                        <a href="{{ k.path }}">{{ k.name }}</a>
                    {% endfor %}
                </div></div>
            </li>
        {% endif %}
    {% endfor %}
</ul></nav>
{% endif %}
</header>
