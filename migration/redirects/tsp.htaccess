RewriteEngine On

Order Allow,Deny
Allow from all
Deny from 149.50.116.40
# polsko nejaky SQL injection

# Header unset Cache-Control
# Header set Cache-Control "no-transform"

# Blokace AI trénovacích crawlerů (bulk scraping, žádný přínos, jen zátěž)
RewriteCond %{HTTP_USER_AGENT} (GPTBot|CCBot|ClaudeBot|anthropic-ai|Bytespider|ByteSpider|ImagesiftBot|Diffbot|YouBot|Amazonbot|Applebot|cohere-ai|Omgilibot|Omgili|Meta-ExternalAgent|Meta-ExternalFetcher|Google-Extended|Timpibot|PetalBot|Awario|DataForSeoBot) [NC]
RewriteRule .* - [F,L]

<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=31536000, no-transform"
</FilesMatch>

# 2. KOMPRESE (zmenší přenášená data)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript
</IfModule>

