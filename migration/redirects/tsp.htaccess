# HTTPS přesměrování
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# DŮLEŽITÉ – ignorovat existující soubory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# fallback
RewriteRule ^([a-zA-Z0-9\-]+)$ index.php?alias=$1 [L,NC]

# stránkování (dát DŘÍV)
RewriteRule ^([a-zA-Z0-9\-]+)/stranka-(.+)$ index.php?alias=$1&strankovani=$2 [L,NC]

# 1. Oprava pro URL s ID a variantou (převod -detail- na _detail-)
RewriteRule ^([a-zA-Z0-9\-_]*)-detail-([0-9]*)-([0-9]*)$ https://www.trickaspotiskem.eu/$1_detail-$2-$3 [R=301,L,NC]

# 2. Oprava pro URL pouze s ID (převod -detail- na _detail-)
RewriteRule ^([a-zA-Z0-9\-_]*)-detail-([0-9]*)$ https://www.trickaspotiskem.eu/$1_detail-$2 [R=301,L,NC]

# detail
RewriteRule ^([a-zA-Z0-9\-_]*)-([0-9]*)-([0-9]*)$ index.php?alias=detail_2&id=$2&id_varianty=$3 [L,NC]
RewriteRule ^([a-zA-Z0-9\-_]*)-([0-9]*)$ index.php?alias=detail&id=$2 [L,NC]

# nova autentizace 07.07.2026
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]